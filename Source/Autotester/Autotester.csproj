  </ItemGroup>
  <ItemGroup>
    <Reference Include="RimWorld">
      <HintPath>..\..\..\..\SteamLibrary\steamapps\common\RimWorld\Assembly-CSharp.dll</HintPath>
      <ExcludeAssets>runtime</ExcludeAssets>
      <CopyLocal>False</CopyLocal>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>..\..\..\..\SteamLibrary\steamapps\common\RimWorld\UnityStubs.dll</HintPath>
      <ExcludeAssets>runtime</ExcludeAssets>
      <CopyLocal>False</CopyLocal>
      <Private>false</Private>
